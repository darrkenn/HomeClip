<div class="bg-nice-footer border-2 rounded-2xl border-white p-2">
    <div class="flex flex-row border-b-2 border-white w-full">
        <div class="w-1/2"><h1 class="text-white text-2xl font-extrabold">Folder</h1></div>
        <div class="w-1/2 justify-end flex">
            <button class="text-white text-lg p-1 font-bold hover:cursor-pointer"
                    hx-get="/api/html/clear"
                    hx-trigger="click"
                    hx-target="#new"
                    hx-swap="innerHTML"
            >Cancel</button>
        </div>
    </div>
    <form hx-post="/api/folders/editfolder" method="post" hx-swap="none" class="flex flex-col gap-2 pt-2" autocomplete="off">
        <div class="flex flex-row">
            <div class="flex flex-col w-1/4 gap-2 text-white font-bold">
                <label class="p-0.5">Name:</label>
                <label class="p-0.5">Colour:</label>
            </div>
            <div class="flex flex-col w-full gap-2 text-black">
                <input class="bg-white p-0.5" type="text" name="name" value="{{.name}}" placeholder="Name" required/>
                <select name="colour"  type="text" class="bg-white p-0.5 text-black">
                    <option value="white" {{if eq .colour "white"}}selected{{end}}>White</option>
                    <option value="red" {{if eq .colour "red"}}selected{{end}}>Red</option>
                    <option value="orange" {{if eq .colour "orange"}}selected{{end}}>Orange</option>
                    <option value="yellow" {{if eq .colour "yellow"}}selected{{end}}>Yellow</option>
                    <option value="green" {{if eq .colour "green"}}selected{{end}}>Green</option>
                    <option value="blue" {{if eq .colour "blue"}}selected{{end}}>Blue</option>
                    <option value="purple" {{if eq .colour "purple"}}selected{{end}}>Purple</option>
                </select>
                <input value="{{.id}}" type="hidden" name="id">
            </div>
        </div>
        <div class="flex items-center justify-end gap-1">
            <button type="submit" class="bg-white text-black font-bold rounded-2xl p-2 hover:cursor-pointer">
                Submit
            </button>
            <button type="button"
                    class="text-black font-bold rounded-2xl p-2 hover:cursor-pointer"
                    hx-delete="/api/folders/delete"
                    hx-swap="none"
                    hx-confirm="Are you sure you want to delete this link"
            >
                <img alt="del" src="/static/svg/delete.svg" class="w-6 h-6">
            </button>
        </div>
    </form>
</div>
